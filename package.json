{
  "name": "vscode-cadmatic",
  "displayName": "CADMATIC Language Support",
  "description": "VSCode extension for CADMATIC language server and syntax highlighting",
  "version": "0.0.1",
  "publisher": "cadmatic",
  "repository": {
    "type": "git",
    "url": "https://github.com/frenki123/cadmatic-vscode"
  },
  "engines": {
    "vscode": "^1.77.0"
  },
  "files": [
    "out/**",
    "bin/**",
    "syntaxes/**",
    "snippets/**",
    "themes/**",
    "media/**",
    "language-configuration.json",
    "LICENSE",
    "README.md"
  ],
  "categories": [
    "Programming Languages",
    "Syntax Highlighters"
  ],
  "activationEvents": [
    "onLanguage:cadmatic",
    "onView:cadmatic.projectManager"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cadmatic",
        "aliases": [
          "CADMATIC",
          "cadmatic"
        ],
        "extensions": [
          ".h",
          ".mac"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cadmatic",
        "scopeName": "source.cadmatic",
        "path": "./syntaxes/cadmatic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cadmatic",
        "path": "./snippets/cadmatic.json"
      }
    ],
    "themes": [
      {
        "label": "Cadmatic Catppuccin Mocha",
        "path": "./themes/catppuccin-mocha-color-theme.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Cadmatic Catppuccin Macchiato",
        "path": "./themes/catppuccin-macchiato-color-theme.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Cadmatic Catppuccin Frappé",
        "path": "./themes/catppuccin-frappe-color-theme.json",
        "uiTheme": "vs-dark"
      },
      {
        "label": "Cadmatic Catppuccin Latte",
        "path": "./themes/catppuccin-latte-color-theme.json",
        "uiTheme": "vs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cadmatic-projects",
          "title": "CADMATIC",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cadmatic-projects": [
        {
          "id": "cadmatic.projectManager",
          "name": "Project Manager",
          "type": "webview"
        }
      ]
    },
    "configurationDefaults": {
      "[cadmatic]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
        "editor.tabSize": 4,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "cadmatic.switchProject",
        "title": "CADMATIC: Switch Project",
        "description": "Switch between CADMATIC project profiles"
      },
      {
        "command": "cadmatic.restartLsp",
        "title": "CADMATIC: Restart LSP",
        "description": "Restart the CADMATIC language server"
      },
      {
        "command": "cadmatic.examplesLiveGrep",
        "title": "CADMATIC: Examples Live Grep",
        "description": "Search in active CADMATIC examples directory"
      },
      {
        "command": "cadmatic.examplesWord",
        "title": "CADMATIC: Examples Search Word",
        "description": "Search word under cursor in active CADMATIC examples directory"
      }
    ],
    "keybindings": [
      {
        "command": "cadmatic.examplesWord",
        "key": "ctrl+alt+shift+f",
        "when": "editorTextFocus && editorLangId == cadmatic"
      }
    ],
    "configuration": {
      "title": "CADMATIC",
      "properties": {
        "cadmatic.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to cadmatic-analyze.exe (e.g., C:\\path\\to\\cadmatic-analyze.exe)"
        },
        "cadmatic.activeProject": {
          "type": "string",
          "default": "",
          "description": "Name of the active CADMATIC project profile to use"
        },
        "cadmatic.projects": {
          "type": "object",
          "default": {},
          "description": "CADMATIC project profiles with installation directories.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "installDir": {
                "type": "string",
                "description": "CADMATIC installation directory (required)"
              },
              "lang": {
                "type": "string",
                "default": "english",
                "description": "Language for diagnostics (optional)"
              },
              "projectDir": {
                "type": "string",
                "default": "",
                "description": "Path to .pms project directory (optional)"
              },
              "extraEnv": {
                "type": "object",
                "default": {},
                "description": "Extra environment variables for include resolution",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["installDir"]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "webpack:watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.57.0",
    "mocha": "^11.7.5",
    "ts-loader": "^9.5.7",
    "typescript": "^5.3.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
