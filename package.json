{
  "name": "vscode-cadmatic",
  "displayName": "CADMATIC Language Support",
  "description": "VSCode extension for CADMATIC language server and syntax highlighting",
  "version": "0.0.1",
  "publisher": "cadmatic",
  "engines": {
    "vscode": "^1.77.0"
  },
  "categories": [
    "Programming Languages",
    "Syntax Highlighters"
  ],
  "activationEvents": [
    "onLanguage:cadmatic"
  ],
  "main": "./out/extension.js",
    "contributes": {
    "languages": [
      {
        "id": "cadmatic",
        "aliases": ["CADMATIC", "cadmatic"],
        "extensions": [".h", ".mac"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cadmatic",
        "scopeName": "source.cadmatic",
        "path": "./syntaxes/cadmatic.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "CADMATIC",
      "properties": {
        "cadmatic.pmsRundir": {
          "type": "string",
          "default": "",
          "description": "PMS_RUNDIR path for include resolution"
        },
        "cadmatic.pmsHome": {
          "type": "string",
          "default": "",
          "description": "PMS_HOME path for include resolution"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.77.0",
    "@types/mocha": "^10.0.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
