{
  "name": "Cadmatic Catppuccin Mocha",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editor.lineHighlightBackground": "#31324480",
    "editor.selectionBackground": "#45475a",
    "editor.inactiveSelectionBackground": "#45475a50",
    "editorLineNumber.foreground": "#6c7086",
    "editorLineNumber.activeForeground": "#abb2bf",
    "editorCursor.foreground": "#f5e0dc",
    "editor.findMatchBackground": "#f9e2af40",
    "editor.findMatchHighlightBackground": "#f9e2af30",
    "editorBracketMatch.background": "#45475a80",
    "editorBracketMatch.border": "#89b4fa",
    "editorGutter.background": "#1e1e2e",
    "editorWidget.background": "#181825",
    "editorWidget.border": "#45475a",
    "editorSuggestWidget.background": "#181825",
    "editorSuggestWidget.border": "#45475a",
    "editorSuggestWidget.selectedBackground": "#313244",
    "editorHoverWidget.background": "#181825",
    "editorHoverWidget.border": "#45475a",
    "scrollbar.shadow": "#181825",
    "scrollbarSlider.background": "#45475a80",
    "scrollbarSlider.hoverBackground": "#45475a",
    "scrollbarSlider.activeBackground": "#585b70",
    "statusBar.background": "#181825",
    "statusBar.foreground": "#cdd6f4",
    "titleBar.activeBackground": "#181825",
    "titleBar.activeForeground": "#cdd6f4",
    "activityBar.background": "#181825",
    "activityBar.foreground": "#cdd6f4",
    "sideBar.background": "#181825",
    "sideBar.foreground": "#cdd6f4",
    "panel.background": "#181825",
    "terminal.foreground": "#cdd6f4",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#f5c2e7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#cdd6f4",
    "errorForeground": "#f38ba8",
    "warningForeground": "#f9e2af",
    "infoForeground": "#94e2d5"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
    },
    {
      "scope": "keyword",
      "settings": { "foreground": "#cba6f7" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#a6e3a1" }
    },
    {
      "scope": "number",
      "settings": { "foreground": "#fab387" }
    },
    {
      "scope": "operator",
      "settings": { "foreground": "#89dceb" }
    },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#89b4fa" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": "variable.other",
      "settings": { "foreground": "#fab387" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#eba0ac" }
    },
    {
      "scope": "entity.name.function.preprocessor",
      "settings": { "foreground": "#f5e0dc" }
    },
    {
      "scope": "support.function",
      "settings": { "foreground": "#f38ba8" }
    },
    {
      "scope": "support.type",
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": "keyword.control",
      "settings": { "foreground": "#cba6f7" }
    },
    {
      "scope": "storage.type",
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#fab387" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#cba6f7",
    "operator": "#89dceb",
    "string": "#a6e3a1",
    "number": "#fab387",
    "comment": "#6c7086",
    "type": "#f9e2af",
    "function": "#89b4fa",
    "function.static": "#b4befe",
    "variable": "#fab387",
    "variable.static": "#f9e2af",
    "parameter": "#eba0ac",
    "macro": "#f5e0dc",
    "function.defaultLibrary": "#f38ba8"
  }
}
