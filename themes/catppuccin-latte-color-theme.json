{
  "name": "Cadmatic Catppuccin Latte",
  "type": "light",
  "colors": {
    "editor.background": "#eff1f5",
    "editor.foreground": "#4c4f69",
    "editor.lineHighlightBackground": "#e6e9ef80",
    "editor.selectionBackground": "#bcc0cc",
    "editor.inactiveSelectionBackground": "#bcc0cc50",
    "editorLineNumber.foreground": "#9ca0b0",
    "editorLineNumber.activeForeground": "#6c6f85",
    "editorCursor.foreground": "#dc8a78",
    "editor.findMatchBackground": "#df8e1d40",
    "editor.findMatchHighlightBackground": "#df8e1d30",
    "editorBracketMatch.background": "#bcc0cc80",
    "editorBracketMatch.border": "#1e66f5",
    "editorGutter.background": "#eff1f5",
    "editorWidget.background": "#e6e9ef",
    "editorWidget.border": "#bcc0cc",
    "editorSuggestWidget.background": "#e6e9ef",
    "editorSuggestWidget.border": "#bcc0cc",
    "editorSuggestWidget.selectedBackground": "#ccd0da",
    "editorHoverWidget.background": "#e6e9ef",
    "editorHoverWidget.border": "#bcc0cc",
    "scrollbar.shadow": "#e6e9ef",
    "scrollbarSlider.background": "#bcc0cc80",
    "scrollbarSlider.hoverBackground": "#bcc0cc",
    "scrollbarSlider.activeBackground": "#acb0be",
    "statusBar.background": "#e6e9ef",
    "statusBar.foreground": "#4c4f69",
    "titleBar.activeBackground": "#e6e9ef",
    "titleBar.activeForeground": "#4c4f69",
    "activityBar.background": "#e6e9ef",
    "activityBar.foreground": "#4c4f69",
    "sideBar.background": "#e6e9ef",
    "sideBar.foreground": "#4c4f69",
    "panel.background": "#e6e9ef",
    "terminal.foreground": "#4c4f69",
    "terminal.ansiBlack": "#acb0be",
    "terminal.ansiRed": "#d20f39",
    "terminal.ansiGreen": "#40a02b",
    "terminal.ansiYellow": "#df8e1d",
    "terminal.ansiBlue": "#1e66f5",
    "terminal.ansiMagenta": "#ea76cb",
    "terminal.ansiCyan": "#179299",
    "terminal.ansiWhite": "#5c5f77",
    "terminal.ansiBrightBlack": "#9ca0b0",
    "terminal.ansiBrightRed": "#d20f39",
    "terminal.ansiBrightGreen": "#40a02b",
    "terminal.ansiBrightYellow": "#df8e1d",
    "terminal.ansiBrightBlue": "#1e66f5",
    "terminal.ansiBrightMagenta": "#ea76cb",
    "terminal.ansiBrightCyan": "#179299",
    "terminal.ansiBrightWhite": "#4c4f69",
    "errorForeground": "#d20f39",
    "warningForeground": "#df8e1d",
    "infoForeground": "#179299"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": { "foreground": "#9ca0b0", "fontStyle": "italic" }
    },
    {
      "scope": "keyword",
      "settings": { "foreground": "#8839ef" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#40a02b" }
    },
    {
      "scope": "number",
      "settings": { "foreground": "#fe640b" }
    },
    {
      "scope": "operator",
      "settings": { "foreground": "#04a5e5" }
    },
    {
      "scope": "entity.name.function",
      "settings": { "foreground": "#1e66f5" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#df8e1d" }
    },
    {
      "scope": "variable.other",
      "settings": { "foreground": "#fe640b" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#e64553" }
    },
    {
      "scope": "entity.name.function.preprocessor",
      "settings": { "foreground": "#dc8a78" }
    },
    {
      "scope": "support.function",
      "settings": { "foreground": "#d20f39" }
    },
    {
      "scope": "support.type",
      "settings": { "foreground": "#df8e1d" }
    },
    {
      "scope": "keyword.control",
      "settings": { "foreground": "#8839ef" }
    },
    {
      "scope": "storage.type",
      "settings": { "foreground": "#df8e1d" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#fe640b" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#8839ef",
    "operator": "#04a5e5",
    "string": "#40a02b",
    "number": "#fe640b",
    "comment": "#9ca0b0",
    "type": "#df8e1d",
    "function": "#1e66f5",
    "function.static": "#7287fd",
    "variable": "#fe640b",
    "variable.static": "#df8e1d",
    "parameter": "#e64553",
    "macro": "#dc8a78",
    "function.defaultLibrary": "#d20f39"
  }
}
