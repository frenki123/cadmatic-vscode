{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CADMATIC",
  "scopeName": "source.cadmatic",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.cadmatic",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.cadmatic",
          "match": "(?i)^\\s*(#include)\\s+(?:(\"[^\"]*\")|([^\\s;]+))",
          "captures": {
            "1": { "name": "keyword.control.directive.include.cadmatic" },
            "2": { "name": "string.quoted.double.cadmatic" },
            "3": { "name": "string.unquoted.include.cadmatic" }
          }
        },
        {
          "name": "meta.preprocessor.define.cadmatic",
          "match": "(?i)^\\s*(#define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.define.cadmatic" },
            "2": { "name": "variable.other.preprocessor.cadmatic" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cadmatic",
          "match": "(?i)\\b(if|else|while|for|loop|return)\\b"
        },
        {
          "name": "keyword.storage.cadmatic",
          "match": "(?i)\\b(extern|global)\\b"
        },
        {
          "name": "constant.language.boolean.cadmatic",
          "match": "(?i)\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cadmatic",
          "match": "(?i)\\b(string|int|float|handle)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cadmatic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cadmatic",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.cadmatic",
          "match": "'(?:[^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cadmatic",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.cadmatic",
          "match": "\\b-?(?:\\d+\\.\\d*|\\.\\d+|\\d+)[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.cadmatic",
          "match": "\\b-?(?:\\d+\\.\\d*|\\.\\d+)\\b"
        },
        {
          "name": "constant.numeric.float.suffix.cadmatic",
          "match": "\\b-?(?:\\d+\\.\\d*|\\.\\d+|\\d+)[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.cadmatic",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.definition.cadmatic",
          "begin": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "1": { "name": "entity.name.function.cadmatic" }
          },
          "patterns": [
            {
              "include": "#types"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            }
          ]
        },
        {
          "name": "meta.function.call.cadmatic",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.cadmatic" }
          }
        }
      ]
    }
  }
}
